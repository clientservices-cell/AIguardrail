{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seed-first/seed-first-guardrail/schemas/seed_first_policy.schema.json",
  "title": "SeedFirstPolicySpec",
  "description": "Machine-readable compliance policy for the Seed-First AI Act (model convention, v2). Tier numbering follows Art. 3; Tier 3 fields are fixed by the Act and cannot be relaxed. Every numeric setting is bounded so a policy cannot neuter the guardrail (review AR-13).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "issuer": { "type": "string", "description": "Community council, regulator or deployer that issued the policy (Art. 3(2))." },
        "instrument": { "type": "string", "enum": ["UN_MODEL_LAW", "EU_REGULATION", "AU_CONVENTION", "VOLUNTARY"] },
        "effective_from": { "type": "string", "format": "date" }
      }
    },
    "tier_1_planetary_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_compute_kwh_per_job": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 },
        "carbon_intensity_threshold_g_co2_kwh": { "type": "number", "exclusiveMinimum": 0, "maximum": 5000 },
        "resource_exhaustion_circuit_breaker": { "type": "boolean", "default": true },
        "max_cumulative_kwh": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000000, "description": "Cumulative resource budget assigned to the deployer (Art. 3(1)(b))." },
        "max_water_liters_per_job": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 },
        "default_carbon_intensity_g_co2_kwh": { "type": "number", "minimum": 0, "maximum": 5000, "description": "Grid intensity assumed when the caller supplies none." }
      },
      "required": ["max_compute_kwh_per_job", "carbon_intensity_threshold_g_co2_kwh"]
    },
    "tier_2_community_sovereignty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jurisdiction_id": { "type": "string", "minLength": 1 },
        "community_consent_required": { "type": "boolean", "default": false },
        "cultural_context_framework": {
          "type": "string",
          "enum": ["UBUNTU", "TILLIT", "INDIGENOUS_CARE", "RELATIONAL_COMMONWEALTH"]
        },
        "custom_rules": {
          "type": "array",
          "description": "Community-defined rules (Art. 3(2)(a), (d)). Each pattern is a case-insensitive regular expression run with a time limit. A rule may govern only its declared scope, must cite a legal basis and adopting body, and is rejected if it blocks the protected-speech canary.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
              "pattern": { "type": "string", "minLength": 1 },
              "unless": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "scope": { "type": "string", "enum": ["RESOURCE_ALLOCATION", "SACRED_OR_TK_DISCLOSURE", "DATA_USE", "CONSENT_PROCESS"] },
              "legal_basis": { "type": "string", "minLength": 3, "description": "The law, customary rule or instrument that authorises the rule." },
              "adopting_body_ref": { "type": "string", "minLength": 3, "description": "Reference to the decision of the body that adopted the rule, for publication and challenge." }
            },
            "required": ["id", "pattern", "reason", "scope", "legal_basis", "adopting_body_ref"]
          }
        }
      },
      "required": ["jurisdiction_id", "cultural_context_framework"]
    },
    "tier_3_inviolable_floor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_human_degradation_tradeoff": { "type": "boolean", "const": false },
        "allow_surveillance_coercion": { "type": "boolean", "const": false },
        "allow_relational_scoring": { "type": "boolean", "const": false },
        "child_protection_override": { "type": "boolean", "const": true }
      },
      "required": ["allow_human_degradation_tradeoff", "allow_surveillance_coercion"]
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require_simulation_for_macro_policy": { "type": "boolean", "default": true },
        "runs": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "worst_case_floor": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "circuit_breaker": {
      "type": "object",
      "additionalProperties": false,
      "description": "Counts confirmed Tier 3 output violations only (Art. 7(2)(a)).",
      "properties": {
        "violation_threshold": { "type": "integer", "minimum": 1, "maximum": 100 },
        "window_seconds": { "type": "number", "minimum": 1, "maximum": 86400 },
        "cooldown_seconds": { "type": "number", "minimum": 60, "maximum": 604800 },
        "min_principals": { "type": "integer", "minimum": 1, "maximum": 1000, "description": "Distinct principals whose violations are needed for a global trip; a single principal is suspended alone." }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fail_closed": { "type": "boolean", "default": true },
        "min_seed_stock_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "judge_threshold": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "judge_timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 300 },
        "capability_monitoring": { "type": "boolean", "default": false, "description": "Run the non-blocking CAPABILITY_SUPPORT judge template for KPI K-23." },
        "audit_include_text": { "type": "boolean", "default": false },
        "screen_prompts": { "type": "boolean", "default": false, "description": "Screen prompts against Tier 3 before calling the model. Completions are always screened." },
        "publication_consent": { "type": "boolean", "default": false, "description": "The community has consented to publication of community-level KPI series." },
        "max_input_chars": { "type": "integer", "minimum": 1, "maximum": 5000000 },
        "unscreenable_content": { "type": "string", "enum": ["block", "allow"], "default": "block" }
      }
    }
  },
  "required": ["tier_1_planetary_boundaries", "tier_2_community_sovereignty", "tier_3_inviolable_floor"]
}
