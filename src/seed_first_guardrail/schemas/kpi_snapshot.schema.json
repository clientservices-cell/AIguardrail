{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seed-first/seed-first-guardrail/schemas/kpi_snapshot.schema.json",
  "title": "SeedFirstKPISnapshot",
  "description": "Public accountability-dashboard snapshot. Aggregates only: suppressed below k, delayed, no rule patterns, thresholds, digests or evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator",
    "generated_at",
    "period",
    "delay_days",
    "k_threshold",
    "community_breakdowns",
    "demonstration",
    "disclaimer",
    "kpis",
    "alerts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "generator": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      }
    },
    "delay_days": {
      "type": "integer",
      "minimum": 0
    },
    "k_threshold": {
      "type": "integer",
      "minimum": 1
    },
    "community_breakdowns": {
      "type": "boolean"
    },
    "demonstration": {
      "type": "boolean"
    },
    "disclaimer": {
      "type": "string",
      "minLength": 1
    },
    "kpis": {
      "type": "array",
      "minItems": 29,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "pillar",
          "formula",
          "plain_language",
          "unit",
          "direction",
          "target",
          "paired_with",
          "value",
          "ci",
          "status",
          "n_band",
          "breakdown",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^K-[0-9]{2}$"
          },
          "name": {
            "type": "string"
          },
          "pillar": {
            "type": "string"
          },
          "formula": {
            "type": "string"
          },
          "plain_language": {
            "type": "string",
            "minLength": 10
          },
          "unit": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "lower",
              "higher",
              "band",
              "info"
            ]
          },
          "target": {
            "type": "object"
          },
          "paired_with": {
            "type": "string",
            "pattern": "^K-[0-9]{2}$"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "ci": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "number",
                "null"
              ]
            },
            "minItems": 2,
            "maxItems": 2
          },
          "status": {
            "enum": [
              "green",
              "amber",
              "red",
              "info",
              "insufficient_data"
            ]
          },
          "n_band": {
            "type": "string"
          },
          "breakdown": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "suppressed"
              ],
              "properties": {
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "suppressed": {
                  "type": "boolean"
                }
              }
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent",
          "code",
          "severity",
          "title",
          "public_summary",
          "plain_language",
          "recommended_action",
          "predicted_breach_at",
          "confidence",
          "requires_human",
          "raised_at"
        ],
        "properties": {
          "agent": {
            "type": "string",
            "pattern": "^CA-[0-9]+$"
          },
          "code": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "critical"
            ]
          },
          "title": {
            "type": "string"
          },
          "public_summary": {
            "type": "string"
          },
          "plain_language": {
            "type": "string",
            "minLength": 10
          },
          "recommended_action": {
            "type": "string"
          },
          "predicted_breach_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ]
          },
          "requires_human": {
            "const": true
          },
          "raised_at": {
            "type": "string"
          }
        }
      }
    },
    "models": {
      "type": "array",
      "description": "Per-model scorecards, named by the model that served each call. Best score first.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "n_band",
          "groups",
          "kpis",
          "rated_kpis",
          "caps",
          "grade",
          "score",
          "plain_language"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "n_band": {
            "type": "string"
          },
          "groups": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "harm",
              "struggle",
              "fairness"
            ],
            "properties": {
              "harm": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "struggle": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "fairness": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "kpis": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "status"
              ],
              "properties": {
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "status": {
                  "enum": [
                    "green",
                    "amber",
                    "red",
                    "info",
                    "insufficient_data"
                  ]
                }
              }
            }
          },
          "rated_kpis": {
            "type": "integer",
            "minimum": 0
          },
          "caps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "grade": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "F",
              null
            ]
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "plain_language": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rating_method": {
      "type": "object",
      "description": "The published grading method (see accountability/scorecards.py)."
    }
  }
}
