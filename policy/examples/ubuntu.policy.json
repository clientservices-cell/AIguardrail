{
  "$schema": "../../src/seed_first_guardrail/schemas/seed_first_policy.schema.json",
  "metadata": {
    "policy_id": "example-ubuntu-county-water",
    "version": "1.0.0",
    "issuer": "Illustrative county water council (example only)",
    "instrument": "AU_CONVENTION",
    "effective_from": "2026-10-01"
  },
  "tier_1_planetary_boundaries": {
    "max_compute_kwh_per_job": 2.0,
    "carbon_intensity_threshold_g_co2_kwh": 250,
    "resource_exhaustion_circuit_breaker": true,
    "max_cumulative_kwh": 500,
    "max_water_liters_per_job": 5,
    "default_carbon_intensity_g_co2_kwh": 120
  },
  "tier_2_community_sovereignty": {
    "jurisdiction_id": "KE",
    "community_consent_required": true,
    "cultural_context_framework": "UBUNTU",
    "custom_rules": [
      {
        "id": "NO_UNILATERAL_WATER_CUTOFF",
        "pattern": "\\b(?:cut\\s+off|disconnect|shut\\s+off)\\s+(?:[\\w'-]+\\s+){0,3}water\\b",
        "unless": "\\b(?:council\\s+approv\\w*|emergency\\s+repair|notice\\s+period)\\b",
        "reason": "Water disconnections require council approval, an emergency repair, or a notice period."
      }
    ]
  },
  "tier_3_inviolable_floor": {
    "allow_human_degradation_tradeoff": false,
    "allow_surveillance_coercion": false,
    "allow_relational_scoring": false,
    "child_protection_override": true
  },
  "simulation": { "require_simulation_for_macro_policy": true, "runs": 64, "worst_case_floor": 0.3 },
  "circuit_breaker": { "violation_threshold": 3, "window_seconds": 600, "cooldown_seconds": 1800 },
  "governance": { "fail_closed": true, "min_seed_stock_score": 0.34, "judge_threshold": 0.5, "audit_include_text": false, "screen_prompts": true }
}
